{
  "name": "AeroDetect Dev Environment (C++/CUDA/TensorRT)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // GPU pass-through is optional and only works on hosts with NVIDIA Container Toolkit installed.
  // Keep this only on machines with a supported NVIDIA GPU; otherwise the container will fail to start.
  "runArgs": [
    "--gpus", "all",
    "--ipc=host",
    "--net=host",
    "-e", "DISPLAY=${env:DISPLAY}",
    "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "customizations": {
    "vscode": {
      // Автоматичне встановлення плагінів для C++, CUDA та Python
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ],
      "settings": {
        "cmake.configureOnOpen": true,
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "cmake.generator": "Unix Makefiles",
        "cmake.configureSettings": {
          "CMAKE_C_COMPILER": "/usr/bin/gcc",
          "CMAKE_CXX_COMPILER": "/usr/bin/g++"
        }
      }
    }
  },
  "remoteUser": "root"
}